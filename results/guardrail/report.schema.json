{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SciencePal 论文核查报告 v1",
  "type": "object",
  "required": [
    "references"
  ],
  "properties": {
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "doi_status",
          "metadata_match",
          "verdict",
          "confidence",
          "evidence_url"
        ],
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1
          },
          "raw_citation": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "doi_status": {
            "enum": [
              "valid",
              "not_found",
              "no_doi"
            ]
          },
          "metadata_match": {
            "type": "boolean"
          },
          "claim_support": {
            "enum": [
              "support",
              "related",
              "no_evidence",
              "inaccessible"
            ]
          },
          "verdict": {
            "enum": [
              "confirm",
              "suspect",
              "pass"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_url": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "methodology": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "check",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "confirm",
              "suspect",
              "pass"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "overall_risk": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "top_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}